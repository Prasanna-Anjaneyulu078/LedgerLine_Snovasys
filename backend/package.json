{
  "name": "ledgerline-backend",
  "version": "1.0.0",
  "description": "LedgerLine Financial Transaction & Double-Entry Ledger Management System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/database/migrate.js",
    "migrate:test": "node src/database/migrate.js --test",
    "setup:runtime-role": "node src/database/setup-runtime-role.js",
    "seed": "node src/database/seed.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles",
    "test:unit": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest tests/integration --runInBand --detectOpenHandles"
  },
  "keywords": [
    "fintech",
    "ledger",
    "double-entry",
    "postgresql",
    "neon",
    "idempotency",
    "concurrency",
    "node-postgres",
    "raw-sql"
  ],
  "author": "LedgerLine Core Team",
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
