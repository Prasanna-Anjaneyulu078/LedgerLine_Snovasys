# Neon PostgreSQL Configuration
# Pooled connection string for application runtime
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLED-HOST/DB?sslmode=require
# Direct connection string for migrations and DDL operations
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/DB?sslmode=require

# Test Database URL
TEST_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-HOST/TEST_DB?sslmode=require

# Server Configuration
PORT=5000
NODE_ENV=development

# Security & Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

