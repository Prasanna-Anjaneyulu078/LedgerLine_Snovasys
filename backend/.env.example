# Neon PostgreSQL Configuration
# Pooled connection string for application runtime (uses restricted least-privilege role: ledgerline_runtime)
DATABASE_URL=postgresql://ledgerline_runtime:RUNTIME_PASSWORD@YOUR-NEON-POOLED-HOST/neondb?sslmode=verify-full
# Direct connection string for migrations, DDL, and administrative setup (uses database owner: neondb_owner)
DIRECT_URL=postgresql://neondb_owner:OWNER_PASSWORD@YOUR-NEON-DIRECT-HOST/neondb?sslmode=verify-full

# Test Database URLs (Dedicated isolated test database)
# Pooled connection string for test runtime operations (restricted runtime role)
TEST_DATABASE_URL=postgresql://ledgerline_runtime:RUNTIME_PASSWORD@YOUR-NEON-POOLED-HOST/ledgerline_test?sslmode=verify-full
# Direct connection string for test migrations and test fixture truncation (database owner)
TEST_DIRECT_URL=postgresql://neondb_owner:OWNER_PASSWORD@YOUR-NEON-DIRECT-HOST/ledgerline_test?sslmode=verify-full

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Security & Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# Local Demonstration Seeding Configuration (required only when running npm run seed)
ALLOW_DEMO_SEED=false
SEED_MIGRATE_LEGACY_USERS=false
SEED_ADMIN_PASSWORD=replace_with_local_seed_admin_password
SEED_AUDITOR_PASSWORD=replace_with_local_seed_auditor_password
SEED_KAVI_PASSWORD=replace_with_local_seed_user1_password
SEED_RAVI_PASSWORD=replace_with_local_seed_user2_password

# Optional Isolated Test Fixture Password (auto-generated if omitted in test runs)
TEST_USER_PASSWORD=replace_with_isolated_test_password

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
